#include <stdio.h>
#include <stdlib.h>

#define MAX 5 // Maximum capacity of the queue

// Global declaration of queue and pointers
int queue[MAX];
int front = -1;
int rear = -1;

// Function prototypes
void insert(int value);
void delete();
void display();

int main() {
    int choice, value;

    while (1) {
        printf("\n--- Linear Queue Operations ---");
        printf("\n1. Insert (Enqueue)");
        printf("\n2. Delete (Dequeue)");
        printf("\n3. Display Queue");
        printf("\n4. Exit");
        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("Enter the value to insert: ");
                scanf("%d", &value);
                insert(value);
                break;
            case 2:
                delete();
                break;
            case 3:
                display();
                break;
            case 4:
                exit(0);
            default:
                printf("Invalid choice! Please choose a valid option.\n");
        }
    }
    return 0;
}

// Function to insert an element into the queue (Enqueue)
void insert(int value) {
    // Check for Queue Overflow
    if (rear == MAX - 1) {
        printf("Queue Overflow! Cannot insert element.\n");
        return;
    }

    // If inserting the first element, set front to 0
    if (front == -1) {
        front = 0;
    }

    rear++;
    queue[rear] = value;
    printf("Successfully inserted %d into the queue.\n", value);
}

// Function to delete an element from the queue (Dequeue)
void delete() {
    // Check for Queue Underflow
    if (front == -1 || front > rear) {
        printf("Queue Underflow! The queue is empty.\n");
        return;
    }

    printf("Deleted element: %d\n", queue[front]);
    front++;

    // Reset the queue pointers if it becomes empty after deletion
    if (front > rear) {
        front = -1;
        rear = -1;
    }
}

// Function to display the elements of the queue
void display() {
    if (front == -1 || front > rear) {
        printf("Queue is empty!\n");
        return;
    }

    printf("Queue elements are: ");
    for (int i = front; i <= rear; i++) {
        printf("%d ", queue[i]);
    }
    printf("\n");
}
